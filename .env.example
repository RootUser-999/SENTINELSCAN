# GEMINI_API_KEY: Optional for AI remediation enrichment if enabled.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SENTINEL_AUTH_SECRET: HMAC signing secret for session tokens (auto-generated in-memory fallback in dev).
SENTINEL_AUTH_SECRET=

# SENTINEL_VAULT_KEY: 32-byte hex key for encrypting scan credentials at rest (auto-generated fallback in dev).
SENTINEL_VAULT_KEY=
